# Google AI Studio key (https://aistudio.google.com/app/apikey); used for Gemini answer generation.
# Optional: comma-separate authorized fallback keys. They are tried after HTTP 401/429 failures.
# Keys in the same Google project still share that project's quota.
GOOGLE_API_KEY=your_google_api_key_here

# Groq key (https://console.groq.com/keys); used for GPT-OSS evaluation judging.
# Optional: comma-separate authorized fallback keys. They are tried after HTTP 401/429 failures.
# Keys in the same Groq organization may still share quota limits.
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides; defaults are checked in src/config.py.
# GENERATOR_MODEL=gemini-3.5-flash-lite  # gemini-3.8-flash is stronger but far slower per call
# GENERATOR_TEMPERATURE=0.0  # evaluation runs at 0 for reproducibility; raise only for demos
# GEMINI_THINKING_LEVEL=low
# JUDGE_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
