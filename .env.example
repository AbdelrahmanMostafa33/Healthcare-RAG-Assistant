[TEMPLATE]
# Groq API key (https://console.groq.com).
# Used to generate answers and, when the judge is Groq, by the evaluation judge.
GROQ_API_KEY=your_groq_api_key_here

# Google AI Studio key (https://aistudio.google.com/apikey).
# Used by the Gemini judge only - not needed if the judge runs on Groq.
# Set this or leave it empty. The judge is chosen in .env with JUDGE_MODEL.
GEMINI_API_KEY=your_gemini_api_key_here

# Judge model.
# - Start with "gemini-3.5-flash-lite" (Gemini, needs GEMINI_API_KEY)
# - Or use "qwen/qwen3.8-27b" (Groq, needs only GROQ_API_KEY)
JUDGE_MODEL=gemini-3.5-flash-lite
