# Groq API key (https://console.groq.com).
# Used for the generator and for the evaluation judge.
# One key only. A comma-separated list is still accepted, but only the first key is used
# (the old key-rotation format is no longer supported).
GROQ_API_KEY=your_groq_api_key_here

# Optional: the evaluation judge model (a Groq model that is not the generator).
# JUDGE_MODEL=qwen/qwen3.8-27b
