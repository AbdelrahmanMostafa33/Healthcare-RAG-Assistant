# Copy this file to .env and fill in the keys you have. Never commit .env.

# REQUIRED for the app: answering questions and the short safety check both use this key.
# Get one at https://aistudio.google.com/app/apikey. Set exactly one key, with no commas.
GOOGLE_API_KEY=your_google_api_key_here

# OPTIONAL: only needed when JUDGE_PROVIDER is groq (the default) and you run the LLM-judge part of
# the evaluation. Get one at https://console.groq.com/keys.
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: only needed when JUDGE_PROVIDER=cerebras. Get one at https://cloud.cerebras.ai/.
CEREBRAS_API_KEY=your_cerebras_api_key_here

# OPTIONAL overrides. The defaults are in src/config.py.
# GENERATOR_PROVIDER=gemini            # only "gemini" is implemented
# GENERATOR_MODEL=gemini-3.5-flash-lite
# GENERATOR_TEMPERATURE=0.0            # evaluation runs at 0; raise it only for demos
# GEMINI_THINKING_LEVEL=low
# GENERATOR_TIMEOUT_MS=30000           # per provider call; /query still returns 504 after 60 s
# JUDGE_PROVIDER=groq                  # or cerebras
# JUDGE_MODEL=openai/gpt-oss-120b      # Cerebras uses gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
