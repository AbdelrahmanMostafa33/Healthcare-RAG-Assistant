# Google AI Studio key (https://aistudio.google.com/app/apikey); used for Gemini answer generation.
# This project uses a single key per provider. Set exactly one value, with no commas.
GOOGLE_API_KEY=your_google_api_key_here

# Groq key (https://console.groq.com/keys); used when JUDGE_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key_here

# Cerebras key (https://cloud.cerebras.ai/); used when JUDGE_PROVIDER=cerebras.
CEREBRAS_API_KEY=your_cerebras_api_key_here

# Optional overrides; defaults are checked in src/config.py.
# GENERATOR_MODEL=gemini-3.5-flash-lite  # gemini-3.8-flash is stronger but far slower per call
# GENERATOR_TEMPERATURE=0.0  # evaluation runs at 0 for reproducibility; raise only for demos
# GEMINI_THINKING_LEVEL=low
# JUDGE_PROVIDER=groq  # or cerebras
# JUDGE_MODEL=openai/gpt-oss-120b  # Groq default; Cerebras uses gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
